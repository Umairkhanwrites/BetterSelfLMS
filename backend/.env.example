# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Admin Authorization (comma-separated admin emails or admin UIDs)
ADMIN_EMAILS=admin@betterself.pk,director@betterself.pk
ADMIN_UIDS=u_admin_001

# Firebase Admin SDK Configuration
# Option 1: Individual credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Option 2: Path to serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Development / Testing Mock Mode
# Set to 'true' to use the in-memory/persisted local mock engine when live Firebase credentials are not yet configured.
MOCK_FIREBASE=false
